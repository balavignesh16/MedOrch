# Required only when the AI engine is enabled.
#
# Recommended for local development: Ollama (https://ollama.com), which
# exposes an OpenAI-compatible endpoint — no code change needed, just these
# three lines. Pull a non-reasoning instruct model first, e.g.:
#   ollama pull llama3.1:8b-instruct
# NVIDIA_API_KEY must be non-empty even though Ollama ignores it.
#
# Model choice, benchmarked on this project's actual planning prompt:
#   llama3.1:8b        ~5GB RAM/VRAM, 5-17s per call, solid baseline
#   qwen2.5:14b-instruct ~9GB RAM/VRAM, 9-26s per call, noticeably better
#                       SQL reasoning (e.g. computes rates/percentages
#                       directly instead of raw counts) — use this if your
#                       hardware has the headroom.
# Both fit comfortably inside AI_LLM_TIMEOUT_SECONDS below either way.
NVIDIA_API_KEY=ollama
NVIDIA_BASE_URL=http://localhost:11434/v1
NVIDIA_MODEL=llama3.1:latest
#
# To use Google Gemini (AI Studio key) instead — same OpenAI-compatible
# client, no code change. Put the key in your local .env only, never here:
#   NVIDIA_API_KEY=<your AI Studio key>
#   NVIDIA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   NVIDIA_MODEL=gemini-2.5-flash
#
# To enable the "Gemini Flash (Cloud)" button in the assistant's model selector
# (independent of the NVIDIA_* settings above, which stay on Ollama), set this
# in your local .env only. Leave it empty and the button reports "not configured".

# Note: prompts (schema + query results) leave your machine when using a
# hosted model; fine for the bundled public de-identified dataset, not for
# real patient data.
#
# To use NVIDIA NIM instead: generate your own key at
# https://build.nvidia.com (never reuse a key that has ever been committed
# to source control or shared in a chat/document), verify your account is
# actually entitled to the model you pick and that it is NOT a "reasoning"
# model (reasoning models generate a large hidden chain-of-thought before
# answering and were observed to take 60s+ per request on the shared tier —
# unusable for this interactive pipeline), then set:
#   NVIDIA_API_KEY=nvapi-...
#   NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#   NVIDIA_MODEL=<a fast, non-reasoning instruct model your key can reach>
ENGINE_HOST=0.0.0.0
ENGINE_PORT=50052
MEDORCH_DB_PATH=database/medorch.db

# Read-only analytics SQL policy limits
AI_QUERY_TIMEOUT_SECONDS=5
AI_QUERY_ROW_LIMIT=200
AI_QUERY_COLUMN_LIMIT=12
AI_SQL_MAX_LENGTH=2000

# LLM request timeout, in seconds. A planner call that exceeds this is
# reported to the client as EXECUTION_STATUS_TIMEOUT / MODEL_TIMEOUT.
# 60s absorbs a cold model load for larger models (e.g. qwen2.5:14b on a
# GPU-constrained machine took 46s+ to load in testing); warm calls return
# in a few seconds to under a minute depending on model size. The planner
# retries once on malformed output (never on timeout), so the engine's
# worst case is roughly 2x this value — keep
# ANALYTICS_REQUEST_TIMEOUT_MS comfortably above that, or the browser will
# cancel the request before the engine gets a chance to fail cleanly.
AI_LLM_TIMEOUT_SECONDS=60

# Privacy-aware audit log. This is a separate SQLite database from the
# analytics data; generated analytics SQL can never reach it. Do not commit
# the resulting database file. No raw prompts or result rows are stored —
# only a SHA-256 hash of the prompt, a redacted excerpt, and row counts.
# Suggested retention: rotate/archive this file periodically (e.g. monthly)
# per your organization's data-retention policy; there is no automatic
# expiry built in yet. Restrict file permissions to the engine's own user.
AI_AUDIT_DB_PATH=database/audit.db

# Gateway and frontend server-side configuration
GATEWAY_ADDRESS=:50051
ANALYTICS_ENGINE_ADDRESS=127.0.0.1:50052
ANALYTICS_GATEWAY_ADDRESS=127.0.0.1:50051
# Overall deadline for one assistant request, gateway included. Must stay
# comfortably above AI_LLM_TIMEOUT_SECONDS's worst case (~2x that value with
# one retry) or the browser cancels the request before the engine can return
# a clean timeout response of its own.
ANALYTICS_REQUEST_TIMEOUT_MS=150000

# Development-only: when "true", the /api/stream SSE payload additionally
# includes executedSql and auditId so developers can inspect what the
# assistant actually ran. Must stay unset/false in any shared or deployed
# environment — these are provenance details, not meant for end users, and
# Phase 3 authentication/authorization is not complete yet.
ANALYTICS_DEV_PROVENANCE=false

# Demonstration mode. Some screens (e.g. Administration: departments, beds,
# staff) need data the bundled dataset does not contain. They are hidden by
# default; set to "true" to preview a clearly labelled demonstration version.
NEXT_PUBLIC_MEDORCH_DEMO_MODE=false
